{
  "name": "cappd",
  "version": "0.1.0",
  "description": "Generic resource budget and reservation engine for TypeScript and Node.js",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx examples/basic/demo.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "rate-limiting",
    "budget",
    "reservation",
    "concurrency",
    "resource-management",
    "reconciliation",
    "redis",
    "lua",
    "middleware",
    "tokens"
  ],
  "author": "Yugendhra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y9ndra/cappd.git"
  },
  "bugs": {
    "url": "https://github.com/y9ndra/cappd/issues"
  },
  "homepage": "https://github.com/y9ndra/cappd#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ioredis": "^6.0.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.0",
    "@types/supertest": "^7.2.1",
    "express": "^5.2.1",
    "supertest": "^7.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
